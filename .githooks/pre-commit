#!/usr/bin/env bash
# Pre-commit gate: run the verification-cost regression suite before allowing a
# commit, so a change that increases (or breaks) verifier work can't land
# silently. See plans/verification-perf-regression.md.
#
# Bypass once with:  git commit --no-verify
set -euo pipefail

echo "[pre-commit] running verification regression tests…"
if ! cargo test --quiet --test perf_regression; then
    echo >&2
    echo "[pre-commit] regression tests FAILED — commit blocked." >&2
    echo "  If the cost change is intentional, refresh the baselines:" >&2
    echo "    UPDATE_PERF_BASELINE=1 cargo test --test perf_regression" >&2
    echo "  then review the diff and re-stage benchmarks/baseline/." >&2
    echo "  To bypass this hook once: git commit --no-verify" >&2
    exit 1
fi
echo "[pre-commit] regression tests passed."
