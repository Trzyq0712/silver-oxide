// L2: boxing (as L1) PLUS Prusti's heap idiom, for the three shapes L1 could not
// reproduce -- join, frame-other-field, and write-then-read.
//
// The idiom, copied from the generated Viper: a location is a predicate `p_Int_i32(r)`
// wrapping a field, reads go through a `..._snap` function that unfolds it, and a write
// is `exhale acc(p_Int_i32(r), write)` followed by a call to the BODYLESS method
// `p_Int_i32_assign`, whose only contract is that it hands back the predicate with the
// new value. Fields of one struct are separate Refs, which is why frame-other-field takes
// two.
//
// Every method here must verify.

domain s_Int_i32 {
  function s_Int_i32_cons(arg0: Int): s_Int_i32
  function s_Int_i32_value(arg0: s_Int_i32): Int

  axiom s_Int_i32_ax_cons {
    (forall s: s_Int_i32 ::
      { s_Int_i32_value(s) }
      s_Int_i32_cons(s_Int_i32_value(s)) == s)
  }

  axiom s_Int_i32_ax_value {
    (forall value: Int ::
      { s_Int_i32_cons(value) }
      -2147483648 <= value && value <= 2147483647 ==>
      s_Int_i32_value(s_Int_i32_cons(value)) == value)
  }
}

domain s_Bool {
  function s_Bool_cons(arg0: Bool): s_Bool
  function s_Bool_value(arg0: s_Bool): Bool

  axiom s_Bool_ax_cons {
    (forall s: s_Bool ::
      { s_Bool_value(s) }
      s_Bool_cons(s_Bool_value(s)) == s)
  }

  axiom s_Bool_ax_value {
    (forall value: Bool ::
      { s_Bool_cons(value) }
      s_Bool_value(s_Bool_cons(value)) == value)
  }
}

field p_Int_i32_val: s_Int_i32
field p_Bool_val: s_Bool

predicate p_Int_i32(self: Ref) {
  acc(self.p_Int_i32_val, write)
}

predicate p_Bool(self: Ref) {
  acc(self.p_Bool_val, write)
}

function p_Int_i32_snap(self: Ref): s_Int_i32
  requires acc(p_Int_i32(self), write)
{
  (unfolding acc(p_Int_i32(self), write) in self.p_Int_i32_val)
}

function p_Bool_snap(self: Ref): s_Bool
  requires acc(p_Bool(self), write)
{
  (unfolding acc(p_Bool(self), write) in self.p_Bool_val)
}

method p_Int_i32_assign(self: Ref, value: s_Int_i32)
  ensures acc(p_Int_i32(self), write)
  ensures p_Int_i32_snap(self) == value

method p_Bool_assign(self: Ref, value: s_Bool)
  ensures acc(p_Bool(self), write)
  ensures p_Bool_snap(self) == value

// --- write_then_read through the predicate heap.
method h_write_then_read(r: Ref, v: s_Int_i32)
  requires acc(p_Int_i32(r), write)
{
  var got: s_Int_i32
  exhale acc(p_Int_i32(r), write)
  p_Int_i32_assign(r, v)
  got := p_Int_i32_snap(r)
  assert got == v
}

// --- frame_other_field: rf and rg are the two fields, as separate locations.
method h_frame_other_field(rf: Ref, rg: Ref, v: s_Int_i32)
  requires acc(p_Int_i32(rf), write)
  requires acc(p_Int_i32(rg), write)
{
  var before: s_Int_i32
  var after: s_Int_i32
  before := p_Int_i32_snap(rf)
  exhale acc(p_Int_i32(rg), write)
  p_Int_i32_assign(rg, v)
  after := p_Int_i32_snap(rf)
  assert before == after
}

// --- join: both arms write the same constant to the same location.
method h_join(b: s_Bool, rflag: Ref)
  requires acc(p_Bool(rflag), write)
{
  var flag: s_Bool
  if (s_Bool_value(b) == false) {
    exhale acc(p_Bool(rflag), write)
    p_Bool_assign(rflag, s_Bool_cons(true))
  } else {
    exhale acc(p_Bool(rflag), write)
    p_Bool_assign(rflag, s_Bool_cons(true))
  }
  flag := p_Bool_snap(rflag)
  assert s_Bool_value(flag) == true
}
