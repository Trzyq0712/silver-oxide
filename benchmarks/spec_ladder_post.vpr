// Spec-position occurrences, the pathological case.
//
// `spec_ladder` with a **vacuous** `ensures true` on every level of the chain.
// The posts say nothing, but before Stage 4 of `design/function-facts/` the mere
// presence of one defeated the presence gate — `need_build = do_union || has
// facts` — so an occurrence with no token of its own still materialized a body,
// which minted another untokened occurrence, and so on down. Stage 4 brought the
// caller's share of the cost back to what the control pays.
//
// Since Stage 6 the `h5` occurrence arriving through `mk#ensures` *is* tokened
// (the export releases `mk#ensures%pre` and the contract body propagates
// `h5%pre`), so the ladder materializes at the client on purpose. What this file
// still guards is the gap against the control: the vacuous `ensures true` per
// level must not cost more than the chain itself.
function h0(x: Int): Int ensures true { x + 1 }
function h1(x: Int): Int ensures true { h0(x) + h0(x + 1) }
function h2(x: Int): Int ensures true { h1(x) + h1(x + 1) }
function h3(x: Int): Int ensures true { h2(x) + h2(x + 1) }
function h4(x: Int): Int ensures true { h3(x) + h3(x + 1) }
function h5(x: Int): Int ensures true { h4(x) + h4(x + 1) }

function mk(x: Int): Int
  ensures result == h5(x)

function consume(y: Int): Int
  requires 0 <= y
{ y }

method client(x: Int)
  requires 0 <= mk(x)
{
  var r: Int := consume(mk(x))
}
