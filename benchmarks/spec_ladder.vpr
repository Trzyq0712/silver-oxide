// Spec-position occurrences, control case.
//
// `mk`'s postcondition mentions `h5`, so a client that calls `mk` sees an `h5`
// application arrive through `mk#ensures`. Since Stage 6 of
// `design/function-facts/` that occurrence is tokened: the export releases
// `mk#ensures%pre`, the contract body propagates `h5%pre`, and the ladder
// materializes at the client. That is the cost of the fact being *usable* —
// `mk(x) == h5(x)` says nothing a client can act on while `h5` stays opaque —
// and Silicon pays the same cascade through its
// `postPreconditionPropagationAxiom`.
//
// Before Stage 6 the caller paid nothing here, because a contract body
// propagated no token at all. The number this file guards is therefore the
// ladder's *steady* cost, not its absence. Pairs with `spec_ladder_post`, which
// adds a vacuous `ensures true` per level.
function h0(x: Int): Int { x + 1 }
function h1(x: Int): Int { h0(x) + h0(x + 1) }
function h2(x: Int): Int { h1(x) + h1(x + 1) }
function h3(x: Int): Int { h2(x) + h2(x + 1) }
function h4(x: Int): Int { h3(x) + h3(x + 1) }
function h5(x: Int): Int { h4(x) + h4(x + 1) }

function mk(x: Int): Int
  ensures result == h5(x)

function consume(y: Int): Int
  requires 0 <= y
{ y }

method client(x: Int)
  requires 0 <= mk(x)
{
  var r: Int := consume(mk(x))
}
