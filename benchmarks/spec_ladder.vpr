// Spec-position occurrences, control case.
//
// `mk`'s postcondition mentions `h5`, so a client that calls `mk` sees an `h5`
// application arrive through `mk#ensures` — a contract body, which propagates no
// precondition token. That occurrence therefore carries no `h5%pre`: no
// value-position call produced it, and the presence gate should keep `h5`'s body
// out of the caller entirely.
//
// Here the `h` chain declares no `ensures`, so there is nothing to publish and
// the gate holds trivially. Pairs with `spec_ladder_post`, which adds a vacuous
// `ensures true` per level — enough, before Stage 4 of
// `design/function-facts/`, to drag all six bodies into the caller.
function h0(x: Int): Int { x + 1 }
function h1(x: Int): Int { h0(x) + h0(x + 1) }
function h2(x: Int): Int { h1(x) + h1(x + 1) }
function h3(x: Int): Int { h2(x) + h2(x + 1) }
function h4(x: Int): Int { h3(x) + h3(x + 1) }
function h5(x: Int): Int { h4(x) + h4(x + 1) }

function mk(x: Int): Int
  ensures result == h5(x)

function consume(y: Int): Int
  requires 0 <= y
{ y }

method client(x: Int)
  requires 0 <= mk(x)
{
  var r: Int := consume(mk(x))
}
