+                    && !self.split_to_depth(&branch, goal, roots, depth - 1, budget)
+                {
+                    both = false;
+                    break;
+                }
+            }
+            if both {
+                return true;
+            }
+        }
+        false
+    }
+}
+
+/// How many nested `ite` conditions tier 4 may split on. A Rust `match` on an
+/// n-variant enum needs n-1 nested splits to exhaust its arms; 3 covers the
+/// 4-variant enums in the Prusti output with room to spare.
+const SPLIT_DEPTH: usize = 3;
+
+/// How many candidate conditions tier 4 considers at one level. With iterative
+/// deepening the depth-1 sweep is linear in this, so it can afford to be wide
+/// enough to absorb a mis-ranking (the condition that decides a CFG join sits
+/// behind a handful of same-shaped `s_Bool_value(..)` applications).
+const SPLIT_FANOUT: usize = 12;
+
+/// Cap on probe saturations per tier-4 goal. Bounds the worst case: an
+/// unprovable goal stops costing time instead of exploring the full case tree.
+const SPLIT_BUDGET: usize = 160;
+
+/// The `ite` conditions worth splitting on: those in the **cone** of `roots`
+/// (the goal and the path-condition literals), whose truth value is not already
+/// decided (a `ConstFold`-known condition splits into one vacuous branch).
+///
+/// The cone, not the whole e-graph: a saturated probe holds hundreds of `ite`s
+/// that have nothing to do with the goal, and trying each as a split point is
+/// what makes naive splitting exponential. The goal of an unreachable-arm check
+/// is the literal `false` and has no cone of its own — which is why the path
+/// condition's terms are roots too. Breadth-first, so nearer conditions (the
+/// ones that actually gate the goal) are tried first.
+fn split_candidates(probe: &egg::EGraph<Symbolic, ConstFold>, roots: &[egg::Id]) -> Vec<egg::Id> {
+    use egg::Language as _;
+    let mut visited: std::collections::HashSet<egg::Id> = std::collections::HashSet::new();
+    let mut seen: std::collections::HashSet<egg::Id> = std::collections::HashSet::new();
+    let mut out = Vec::new();
+    let mut queue: std::collections::VecDeque<egg::Id> =
+        roots.iter().map(|id| probe.find(*id)).collect();
+
+    while let Some(id) = queue.pop_front() {
+        if !visited.insert(id) {
+            continue;
+        }
+        for node in &probe[id].nodes {
+            if let Symbolic::Ite([c, _, _]) = node {
+                let c = probe.find(*c);
+                if probe[c].data.known().is_none() && seen.insert(c) {
+                    out.push(c);
+                }
+            }
+            for child in node.children() {
+                queue.push_back(probe.find(*child));
+            }
+        }
+    }
+    // Rank before truncating. The cone's *nearest* `ite` conditions are mostly
+    // permission comparisons (`0 < perm`, from the `present ? Some(v) : None`
+    // snapshot wrappers and conditional `acc`s) — a permission can never decide a
+    // branch of the source program, yet there are enough of them to crowd out the
+    // atoms that can. The atoms that *do* decide one are opaque booleans: an ADT
+    // variant tag (`iss_Shape_2_cons`, from `match s { Shape::Bounds(..) => .. }`)
+    // or an uninterpreted boolean function — i.e. a `FuncApp`. Rank those first
+    // and the `<`-headed permission checks last; a source-level `if p.x < 0` is
+    // also `<`-headed, so this is a preference, not a filter, and a big enough
+    // fanout still reaches it.
+    let rank = |c: &egg::Id| -> u8 {
+        let nodes = &probe[*c].nodes;
+        if nodes.iter().any(|n| matches!(n, Symbolic::FuncApp(..))) {
+            0
+        } else if nodes
+            .iter()
+            .any(|n| matches!(n, Symbolic::Binary(BinOp::Lt, _)))
+        {
+            2
+        } else {
+            1
+        }
+    };
+    out.sort_by_key(rank);
+    out.truncate(SPLIT_FANOUT);
+    out
 }
