+        goal: egg::Id,
+        roots: &[egg::Id],
+    ) -> bool {
+        let mut budget = SPLIT_BUDGET;
+        for depth in 1..=SPLIT_DEPTH {
+            if self.split_to_depth(probe, goal, roots, depth, &mut budget) {
+                self.alloc.stats.prove_splits += 1;
+                return true;
+            }
+            if budget == 0 {
+                break;
+            }
+        }
+        false
+    }
