+    /// Prove `goal` by a case tree of exactly `depth` nested splits (see
+    /// [`Self::split_prove`]). Returns `false` once `budget` is exhausted.
+    fn split_to_depth(
+        &mut self,
+        probe: &egg::EGraph<Symbolic, ConstFold>,
+        goal: egg::Id,
+        roots: &[egg::Id],
+        depth: usize,
+        budget: &mut usize,
+    ) -> bool {
+        if depth == 0 || *budget == 0 {
+            return false;
+        }
+        for cond in split_candidates(probe, roots) {
+            let mut both = true;
+            for want_true in [true, false] {
+                if *budget == 0 {
+                    return false;
+                }
+                *budget -= 1;
+                let mut branch = probe.clone();
+                let lit = branch.add(Symbolic::Lit(Literal::Bool(want_true)));
+                branch.union(cond, lit);
