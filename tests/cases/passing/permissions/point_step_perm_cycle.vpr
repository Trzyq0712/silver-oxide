function mir_binop_AddWithOverflow_Int_i32_Int_i32(arg1: s_Int_i32, arg2: s_Int_i32): s_2_Tuple
{
  (let val ==
    (s_Int_i32_value(arg1) + s_Int_i32_value(arg2)) in
    (let wrapped_val ==
      ((val + 2147483648) % 4294967296 - 2147483648) in
      s_2_Tuple_cons(make_generic_s_Int_i32(s_Int_i32_cons(wrapped_val)), make_generic_s_Bool(s_Bool_cons(wrapped_val !=
      val)))))
}

function mir_binop_SubWithOverflow_Int_i32_Int_i32(arg1: s_Int_i32, arg2: s_Int_i32): s_2_Tuple
{
