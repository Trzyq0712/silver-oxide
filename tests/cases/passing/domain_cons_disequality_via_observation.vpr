// `distinguishing-observation`: disproving an equality from a **distinguishing
// observation**, the contrapositive of congruence at the application.
//
// Congruence gives `a ≡ b ⟹ f(a) ≡ f(b)`. So if some `f` has `f(a)` and `f(b)`
// in classes whose fingerprints differ, `a == b` must be `false`. Sound for any
// `f` — this needs no injectivity premise, only congruence.
//
// Why it matters: Prusti encodes a *primitive* snapshot (`s_Int_isize`) as a
// **domain** with a `cons`/`value` retraction, not as an `adt`, so two `cons`
// applications carry no free-constructor distinctness. `ax_value` does put
// `value(cons(1)) ≡ 1` and `value(cons(2)) ≡ 2` in the graph, and those separate
// them. The retraction is also what makes `cons` injective, but the *rule* never
// appeals to injectivity — it only reads the two observations.
//
// `d1` was already provable by refutation before this rule (asserting a
// disequality lets the prover merge and hit `1 == 2`). `d2` is the same fact
// needed as an in-graph `Eq(..) = false` so that `ite-reduce` and
// `eq-false-then/else` can consume it, and that is what was missing.

domain S {
  function cons(arg0: Int): S
  function value(arg0: S): Int
  axiom ax_cons { (forall s: S :: { value(s) } cons(value(s)) == s) }
  axiom ax_value { (forall v: Int :: { cons(v) } value(cons(v)) == v) }
}

// Refutable even without the rule.
method d1(x: S)
{
  assume x == cons(1)
  assert x != cons(2)
}

// The same fact as an `ite` guard — needs the disequality pinned in-graph.
method d2(x: S)
{
  assume x == cons(1)
  assert (x == cons(2) ? 7 : 9) == 9
}

// Via the unboxed spelling the real encoding uses.
method d3(x: S)
{
  assume value(x) == 1
  assert x != cons(2)
}
