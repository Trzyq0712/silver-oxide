// SOUNDNESS CANARY for the gate split in `sufficient_leaf`.
//
// Unfolding `Outer` yields `acc(Q(s))` with the amount `ite(isnap(discr(s)) ==
// cons(1), 1/1, 0)`. The split proves that amount sufficient per arm — `1/1` under
// the gate and `0` under its negation — and the second arm may only be discharged
// when the negation refutes itself.
//
// Here nothing decides the gate: the branch tests `value(tmp) == 2`, so on the
// taken path the discriminant is `cons(2)`, and the `0` arm is genuinely reachable.
// Accepting this would mean the split had proved `0 >= 1/1` outright.
domain S {
  function cons(arg0: Int): S
  function value(arg0: S): Int

  axiom ax_cons { (forall s: S :: { value(s) } cons(value(s)) == s) }
  axiom ax_value { (forall v: Int :: { cons(v) } value(cons(v)) == v) }
}

field val: S

predicate Inner(x: Ref) { acc(x.val, write) }

function isnap(x: Ref): S
  requires acc(Inner(x), write)
{ (unfolding acc(Inner(x), write) in x.val) }

function discr(s: Ref): Ref

predicate Q(s: Ref) { acc(s.val, write) }

predicate Outer(s: Ref) {
  acc(Inner(discr(s)), write) &&
  (isnap(discr(s)) == cons(1) ==> acc(Q(s), write))
}

method m(s: Ref)
  requires acc(Outer(s), write)
{
  var tmp: S
  tmp := (unfolding acc(Outer(s), wildcard) in isnap(discr(s)))
  if (value(tmp) == 2) {
    unfold acc(Outer(s), write)
    unfold acc(Q(s), write)
  }
}
