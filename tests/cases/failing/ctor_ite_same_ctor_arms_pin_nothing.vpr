// Soundness canary for the constructor half of `ite-reduce`'s arm-differs
// pinning (see passing/ctor_arm_pins_ite_condition.vpr).
//
// The fingerprint is the constructor's *identity*, not the whole term, so two
// applications of one constructor never separate — even here, where the
// payloads are known to differ. Losing that is incompleteness; pinning `b`
// would be unsound. Must stay rejected.

adt SH { c0() c1(x: Int) }

method same_ctor_different_payloads(b: Bool, x: Int, y: Int)
  requires x != y
{
  assume (b ? c1(x) : c1(y)) == c1(x)
  assert b
}
