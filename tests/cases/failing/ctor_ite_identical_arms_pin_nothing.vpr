// Soundness canary for the constructor half of `ite-reduce`'s arm-differs
// pinning (see passing/ctor_arm_pins_ite_condition.vpr).
//
// Both arms are the *same* constructor application, so neither can be ruled
// out and the equality says nothing about `b`. Must stay rejected.

adt SH { c0() c1(x: Int) }

method identical_arms_say_nothing(b: Bool)
{
  assume (b ? c0() : c0()) == c0()
  assert b
}
