// KNOWN LIMITATION — should verify, currently rejected.
//
// The last gap in enum snapshot tower inversion, and what still blocks
// `shape_area::m_shape_grow` / `m_shape_translate` in benchmarks/rust (measured:
// asserting the discriminant equality by hand makes arms 0-3 verify and leaves
// exactly the arm-4 assert failing).
//
// `ite-reduce`'s arm-differs pinning telescopes a tower from the bottom: each
// non-matching arm is a ground constructor whose fingerprint separates it from
// the class, so its guard pins false and `ite(false, _, e) => e` exposes the next
// level. That works for every arm *except the outermost*:
//
//     T4 = ite(d == cons(4), c4(), T3)
//
// with the class pinned to `Ctor(c4)`, the then-arm has the *same* constructor
// (no pin, correctly — it could be the taken one) and the else-arm `T3` is an
// undecided `ite`, whose `ConstFold` data is `Unknown`. No fingerprint, no pin.
// Every leaf of `T3` is a constructor other than `c4`, so the conclusion is
// available in principle; representing it needs a fingerprint that survives an
// `ite` — a set-of-constructors lattice value, or a bounded recursive
// `arm_differs` through undecided arms.
//
// Identical to passing/predicates/domain_cons_tower_inversion.vpr except that the
// permission gate and the branch target the tower's outermost arm (cons(4))
// rather than its innermost (cons(1)).
domain S {
  function cons(arg0: Int): S
  function value(arg0: S): Int

  axiom ax_cons { (forall s: S :: { value(s) } cons(value(s)) == s) }
  axiom ax_value { (forall v: Int :: { cons(v) } value(cons(v)) == v) }
}

domain PARAM { }

adt SH { c0() c1() c2() c3() c4() }

function mk_generic(self: SH): PARAM
  ensures mk_concrete(result) == self

function mk_concrete(snap: PARAM): SH
  ensures mk_generic(result) == snap

field val: S
field oval: PARAM

predicate Inner(x: Ref) { acc(x.val, write) }

function isnap(x: Ref): S
  requires acc(Inner(x), write)
{ (unfolding acc(Inner(x), write) in x.val) }

function discr(s: Ref): Ref

predicate Q(s: Ref) { acc(s.val, write) }

predicate Outer(s: Ref) {
  acc(Inner(discr(s)), write) &&
  (isnap(discr(s)) == cons(4) ==> acc(Q(s), write))
}

// Prusti's `p_Shape_snap`: a 5-deep ternary over the discriminant, arms are
// distinct constructors of one ADT.
function Outer_snap(s: Ref): SH
  requires acc(Outer(s), write)
{
  (unfolding acc(Outer(s), write) in
    (isnap(discr(s)) == cons(4) ? c4() :
      (isnap(discr(s)) == cons(3) ? c3() :
        (isnap(discr(s)) == cons(2) ? c2() :
          (isnap(discr(s)) == cons(1) ? c1() : c0())))))
}

predicate Param(s: Ref) { acc(s.oval, write) }

function Param_snap(s: Ref): PARAM
  requires acc(Param(s), write)
{ (unfolding acc(Param(s), write) in s.oval) }

method make_generic(self: Ref)
  requires acc(Outer(self), write)
  ensures acc(Param(self), write)
  ensures old(mk_generic(Outer_snap(self))) == Param_snap(self)

method make_concrete(self: Ref)
  requires acc(Param(self), write)
  ensures acc(Outer(self), write)
  ensures old(Param_snap(self)) == mk_generic(Outer_snap(self))

method m(s: Ref)
  requires acc(Param(s), write)
{
  var tmp: S
  make_concrete(s)
  tmp := (unfolding acc(Outer(s), wildcard) in isnap(discr(s)))
  make_generic(s)
  if (value(tmp) == 4) {
    make_concrete(s)
    unfold acc(Outer(s), write)
    unfold acc(Q(s), write)
  }
}
