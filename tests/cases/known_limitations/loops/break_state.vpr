// KNOWN LIMITATION: `break` (a goto out of a loop) needs `HeapInst::Union`
// and the post-loop confluence rule — stages 5-6, NOT in the stages 0-4
// branch. Silicon verifies this program.
// Tracking: design/loops/PLAN.md sections 4.3 and 5 (scenarios S4, S16).

// S4: an out edge carries the body's LIVE state and does NOT re-establish
// the invariant. `i <= 5` is violated at the break point, yet `i == 6` is
// provable afterwards.
method break_state() returns (i: Int)
{
    var n: Int := 10
    i := 0
    while (i < n)
        invariant i <= 5
    {
        i := i + 1
        if (i > 5) { goto brk }
    }
    label brk
    assert i == 6
}
